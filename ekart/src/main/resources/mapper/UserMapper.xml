<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.ekart.repository.UserRepository">

    <insert id="insertUser" parameterType="com.example.ekart.model.User">
        INSERT INTO users (name, email, password)
        VALUES (#{name}, #{email}, #{password})
    </insert>

    <select id="findByEmail" resultType="com.example.ekart.model.User">
        SELECT * FROM users WHERE email = #{email}
    </select>
    
    <update id="updateLastLogin">
    UPDATE users 
    SET last_login = NOW()
    WHERE email = #{email}
    </update>
    <select id="findByEmailAndNotId"
            resultType="com.example.ekart.model.User">

        SELECT *
        FROM users
        WHERE email = #{email}
        AND id != #{id}

    </select>

    <update id="updateProfile"
            parameterType="com.example.ekart.model.User">

        UPDATE users
        SET
        name = #{name},
        email = #{email}
        WHERE id = #{id}

    </update>
    <update id="updatePassword">

        UPDATE users
        SET password = #{password}
        WHERE id = #{id}

    </update>
    <select id="findById"
            resultType="com.example.ekart.model.User">

        SELECT *
        FROM users
        WHERE id = #{id}

    </select>

</mapper>